{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-llm-learner.local/schemas/model-recipe.schema.json",
  "title": "Open LLM Learner Model Recipe",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "id",
    "name",
    "tasks",
    "architecture_family",
    "output_capabilities",
    "training_methods"
  ],
  "properties": {
    "format": {
      "const": "open-llm-learner.model-recipe"
    },
    "format_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "dataset_contracts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "architecture_family": {
      "type": "string",
      "minLength": 1
    },
    "training_objective": {
      "type": [
        "string",
        "null"
      ]
    },
    "output_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "training_methods": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "config_schema": {
      "type": [
        "object",
        "null"
      ]
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": true
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": true
    },
    "runtime_compatibility": {
      "type": "object",
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

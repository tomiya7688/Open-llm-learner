{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-llm-learner.local/schemas/training-pipeline.schema.json",
  "title": "Open LLM Learner Training Pipeline",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "id",
    "stages"
  ],
  "properties": {
    "format": {
      "const": "open-llm-learner.training-pipeline"
    },
    "format_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "task": {
            "type": [
              "string",
              "null"
            ]
          },
          "recipe": {
            "type": [
              "string",
              "null"
            ]
          },
          "training_method": {
            "type": [
              "string",
              "null"
            ]
          },
          "input_refs": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "config": {
            "type": "object",
            "additionalProperties": true
          },
          "evaluation_gate": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          },
          "outputs": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

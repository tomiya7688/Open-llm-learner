{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://open-llm-learner.local/schemas/agent-preset.schema.json",
  "title":"Open LLM Learner Agent Preset",
  "type":"object",
  "required":["format","format_version","id","name","version","description","model_roles","workspace","policies"],
  "properties":{
    "format":{"const":"open-llm-learner.agent-preset"},
    "format_version":{"const":1},
    "id":{"type":"string","minLength":1},
    "name":{"type":"string","minLength":1},
    "version":{"type":"string","minLength":1},
    "description":{"type":"string"},
    "basis":{
      "type":"object",
      "properties":{
        "type":{"enum":["research","product","community"]},
        "title":{"type":"string"},
        "url":{"type":"string"}
      },
      "additionalProperties":true
    },
    "model_roles":{
      "type":"object",
      "additionalProperties":{
        "type":"object",
        "required":["capability"],
        "properties":{
          "capability":{"type":"string"},
          "binding":{"type":["string","null"]},
          "optional":{"type":"boolean"}
        },
        "additionalProperties":true
      }
    },
    "required_capabilities":{
      "type":"array",
      "items":{"type":"string"},
      "uniqueItems":true
    },
    "workspace":{
      "type":"object",
      "additionalProperties":{"type":"string"}
    },
    "entrypoints":{
      "type":"object",
      "additionalProperties":{"type":"string"}
    },
    "policies":{"type":"object"},
    "defaults":{"type":"object"},
    "metadata":{"type":"object"}
  },
  "additionalProperties":false
}

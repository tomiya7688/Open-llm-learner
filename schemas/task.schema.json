{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-llm-learner.local/schemas/task.schema.json",
  "title": "Open LLM Learner Task",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "id",
    "name",
    "inputs",
    "outputs",
    "capability"
  ],
  "properties": {
    "format": {
      "const": "open-llm-learner.task"
    },
    "format_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": true
    },
    "outputs": {
      "type": "object",
      "additionalProperties": true
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "dataset_contracts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "supported_recipe_families": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

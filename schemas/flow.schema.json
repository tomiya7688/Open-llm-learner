{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://open-llm-learner.local/schemas/flow.schema.json",
  "title":"Open LLM Learner Flow",
  "type":"object",
  "required":["format","format_version","id","nodes"],
  "properties":{
    "format":{"const":"open-llm-learner.flow"},
    "format_version":{"const":1},
    "id":{"type":"string","minLength":1},
    "name":{"type":"string"},
    "inputs":{"type":"object","additionalProperties":{"$ref":"#/$defs/port"}},
    "outputs":{"type":"object","additionalProperties":{"$ref":"#/$defs/port"}},
    "nodes":{
      "type":"array",
      "items":{"$ref":"#/$defs/node"}
    },
    "edges":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["from","to"],
        "properties":{
          "from":{"type":"string","minLength":1},
          "to":{"type":"string","minLength":1}
        },
        "additionalProperties":false
      },
      "default":[]
    }
  },
  "$defs":{
    "port":{
      "type":"object",
      "properties":{
        "type":{"enum":["null","boolean","integer","number","string","array","object","reference","any"]},
        "required":{"type":"boolean","default":true},
        "description":{"type":"string"}
      },
      "additionalProperties":true
    },
    "retry":{
      "type":"object",
      "required":["max"],
      "properties":{
        "max":{"type":"integer","minimum":0},
        "delay_ms":{"type":"integer","minimum":0,"default":0}
      },
      "additionalProperties":false
    },
    "node":{
      "type":"object",
      "required":["id","type"],
      "properties":{
        "id":{"type":"string","minLength":1},
        "type":{"enum":["start","end","mod","branch","loop","set","get","flow.call"]},
        "mod":{"type":"string"},
        "action":{"type":"string"},
        "capability":{"type":"string"},
        "flow":{"type":"string"},
        "inputs":{"type":"object"},
        "after":{"type":"array","items":{"type":"string"},"uniqueItems":true},
        "timeout_ms":{"type":"integer","minimum":1},
        "retry":{"$ref":"#/$defs/retry"},
        "condition":{"type":"object"},
        "until":{"type":"object"},
        "max_iterations":{"type":"integer","minimum":1},
        "key":{"type":"string"},
        "value":{}
      },
      "allOf":[
        {
          "if":{"properties":{"type":{"const":"mod"}},"required":["type"]},
          "then":{"anyOf":[{"required":["mod","action"]},{"required":["capability"]}]}
        },
        {
          "if":{"properties":{"type":{"const":"loop"}},"required":["type"]},
          "then":{"required":["max_iterations"]}
        },
        {
          "if":{"properties":{"type":{"const":"flow.call"}},"required":["type"]},
          "then":{"required":["flow"]}
        }
      ],
      "additionalProperties":false
    }
  },
  "additionalProperties":false
}
